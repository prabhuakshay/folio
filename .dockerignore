# Keep the build context small and secrets out of every layer. .gitignore is
# kept on purpose: Tailwind reads it to decide which files to scan.

.git
.venv
node_modules
**/__pycache__/
*.py[cod]
.ruff_cache

# Local state and secrets
.env
.env.*
!.env.example
db.sqlite3
media/

# Regenerated inside the image
staticfiles/
static/css/app.css
