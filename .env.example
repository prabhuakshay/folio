# =============================================================================
# folio — environment configuration
# =============================================================================
#
# HOW TO USE
#   1. Copy this file:            cp .env.example .env
#   2. Fill in the REQUIRED values (only SECRET_KEY is strictly required).
#   3. Uncomment/adjust anything else you need; commented-out lines fall back
#      to the default shown next to them.
#
# NOTES
#   - `.env` is git-ignored. Never commit real secrets.
#   - Real environment variables take precedence over values in `.env`, so in
#     production you can skip the file and set variables via systemd, Docker,
#     your PaaS, etc.
#   - Booleans accept: true/false, yes/no, on/off, 1/0 (case-insensitive).
#   - Lists are comma-separated with no spaces: a.com,b.com
#   - Values containing `#`, spaces or quotes should be wrapped in quotes.
#   - Settings are read once at startup; restart the server after changes.
#
# The defaults are production-safe. The values set below are for local
# development — review every section before deploying.


# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------

# REQUIRED. Cryptographic signing key for sessions, password reset tokens,
# CSRF, signed cookies, etc. Must be long, random and kept secret. Use a
# different key per environment.
#
# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# https://docs.djangoproject.com/en/6.1/ref/settings/#secret-key
SECRET_KEY=change-me

# Previous secret keys still accepted for verifying existing signatures, so
# key rotation doesn't log everyone out. To rotate: move the current
# SECRET_KEY here, set a new SECRET_KEY, and remove the old one once sessions
# and tokens signed with it have expired.
# Default: (empty)
# https://docs.djangoproject.com/en/6.1/ref/settings/#secret-key-fallbacks
# SECRET_KEY_FALLBACKS=old-key-1,old-key-2

# Shows detailed error pages and enables development conveniences.
# NEVER enable in production: it leaks settings, source code and SQL.
# Default: False
# https://docs.djangoproject.com/en/6.1/ref/settings/#debug
DEBUG=True

# Host/domain names this site may serve. Requests with any other Host header
# are rejected (400). A leading dot matches subdomains: .example.com
# Required when DEBUG=False. When DEBUG=True and empty, Django allows
# localhost, 127.0.0.1 and [::1].
# Default: (empty)
# https://docs.djangoproject.com/en/6.1/ref/settings/#allowed-hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (scheme + host [+ port]) trusted for unsafe requests (POST,
# PUT, ...). Needed when the site is served over HTTPS behind a proxy or on a
# domain/port that differs from the Host header.
# Default: (empty)
# https://docs.djangoproject.com/en/6.1/ref/settings/#csrf-trusted-origins
# CSRF_TRUSTED_ORIGINS=https://folio.example.com

# URL prefix for the Django admin. Changing it from the well-known default
# cuts down on automated login attempts. Must end with a slash.
# Default: admin/
# ADMIN_URL=admin/


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Database connection as a URL. Special characters in the password must be
# percent-encoded (e.g. @ -> %40, : -> %3A, / -> %2F).
#
# Formats:
#   SQLite:      sqlite:////absolute/path/to/db.sqlite3
#                sqlite:///relative/path/db.sqlite3
#   PostgreSQL:  postgres://USER:PASSWORD@HOST:5432/NAME
#   MySQL:       mysql://USER:PASSWORD@HOST:3306/NAME
#
# Extra connection settings can be added as query parameters:
#   conn_max_age=600         Keep connections open for N seconds (0 = close
#                            after each request, the Django default).
#   conn_health_checks=true  Check persistent connections before reuse. The
#                            value isn't parsed as a boolean (even "false"
#                            enables it), so omit the parameter to disable.
#   e.g. postgres://folio:secret@localhost:5432/folio?conn_max_age=600&conn_health_checks=true
#
# Default: sqlite:///<project root>/db.sqlite3
# https://django-environ.readthedocs.io/en/latest/types.html#environ-env-db-url
# DATABASE_URL=sqlite:///db.sqlite3


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

# Cache backend as a URL.
#
# Formats:
#   Local memory (per process):  locmemcache://
#   Dummy (no caching):          dummycache://
#   Database table:              dbcache://TABLE_NAME   (then run: manage.py createcachetable)
#   Filesystem:                  filecache:///var/tmp/folio_cache
#   Redis:                       redis://HOST:6379/1
#                                rediss://:PASSWORD@HOST:6379/1  (TLS)
#   Memcached:                   pymemcache://HOST:11211
#
# Use a shared backend (Redis/Memcached/database) when running more than one
# process, otherwise each process has its own cache.
# Default: locmemcache://
# https://django-environ.readthedocs.io/en/latest/types.html#environ-env-cache-url
# CACHE_URL=locmemcache://


# -----------------------------------------------------------------------------
# Security (HTTPS)
# -----------------------------------------------------------------------------
# Enable these once the site is served over HTTPS. Run
# `uv run python manage.py check --deploy` to audit the configuration.

# Redirect all HTTP requests to HTTPS. Leave off if your proxy/load balancer
# already does this, or you'll get a redirect loop unless
# USE_X_FORWARDED_PROTO is also set.
# Default: False
# https://docs.djangoproject.com/en/6.1/ref/settings/#secure-ssl-redirect
# SECURE_SSL_REDIRECT=False

# Trust the X-Forwarded-Proto header to detect HTTPS. Enable ONLY when behind
# a proxy that always sets/overwrites this header (nginx, Traefik, a cloud
# load balancer); otherwise clients can spoof it.
# Default: False
# https://docs.djangoproject.com/en/6.1/ref/settings/#secure-proxy-ssl-header
# USE_X_FORWARDED_PROTO=False

# Only send session/CSRF cookies over HTTPS.
# Default: True when DEBUG=False, False when DEBUG=True
# https://docs.djangoproject.com/en/6.1/ref/settings/#session-cookie-secure
# https://docs.djangoproject.com/en/6.1/ref/settings/#csrf-cookie-secure
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security: tells browsers to only use HTTPS for this
# many seconds. Start small (e.g. 3600) and raise to 31536000 (1 year) once
# confirmed working — browsers cache it, so a mistake locks users out of
# plain HTTP for the whole duration.
# Default: 0 (disabled)
# https://docs.djangoproject.com/en/6.1/ref/settings/#secure-hsts-seconds
# SECURE_HSTS_SECONDS=0

# Apply HSTS to all subdomains too. Only enable if every subdomain serves HTTPS.
# Default: False
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Allow submission to browsers' built-in HSTS preload list (hstspreload.org).
# Requires SECURE_HSTS_SECONDS >= 31536000 and INCLUDE_SUBDOMAINS. Very hard
# to undo.
# Default: False
# SECURE_HSTS_PRELOAD=False


# -----------------------------------------------------------------------------
# Internationalization
# -----------------------------------------------------------------------------

# Default language for the site.
# Default: en-us
# https://docs.djangoproject.com/en/6.1/ref/settings/#language-code
# LANGUAGE_CODE=en-us

# Time zone used to display dates/times and in forms. Datetimes are always
# stored in UTC in the database. Use an IANA name, e.g. Asia/Kolkata,
# Europe/Berlin.
# Default: UTC
# https://docs.djangoproject.com/en/6.1/ref/settings/#time-zone
# TIME_ZONE=UTC


# -----------------------------------------------------------------------------
# Static and media files
# -----------------------------------------------------------------------------

# URL prefix for static files (CSS/JS/images shipped with the code). Set to a
# full URL when serving from a CDN, e.g. https://cdn.example.com/static/
# Default: static/
# https://docs.djangoproject.com/en/6.1/ref/settings/#static-url
# STATIC_URL=static/

# Absolute directory `manage.py collectstatic` copies static files into for
# the web server to serve in production.
# Default: <project root>/staticfiles
# https://docs.djangoproject.com/en/6.1/ref/settings/#static-root
# STATIC_ROOT=/var/www/folio/static

# URL prefix for user-uploaded files.
# Default: media/
# https://docs.djangoproject.com/en/6.1/ref/settings/#media-url
# MEDIA_URL=media/

# Absolute directory where user-uploaded files are stored. Must be writable by
# the app and persist across deploys; back it up.
# Default: <project root>/media
# https://docs.djangoproject.com/en/6.1/ref/settings/#media-root
# MEDIA_ROOT=/var/lib/folio/media


# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

# Outgoing email as a URL. Username/password must be percent-encoded
# (e.g. user@example.com -> user%40example.com).
#
# Formats:
#   Print to console (dev):     consolemail://
#   Write to files:             filemail:///absolute/path/to/dir
#   Keep in memory (tests):     memorymail://
#   Discard:                    dummymail://
#   SMTP, no encryption:        smtp://USER:PASSWORD@HOST:25
#   SMTP + STARTTLS (587):      smtp+tls://USER:PASSWORD@HOST:587
#   SMTP over SSL (465):        smtp+ssl://USER:PASSWORD@HOST:465
#
# Add ?timeout=SECONDS to limit how long SMTP operations may block, e.g.
#   smtp+tls://apikey:secret@smtp.example.com:587?timeout=10
#
# Default: consolemail://
# https://docs.djangoproject.com/en/6.1/topics/email/
# EMAIL_URL=consolemail://

# Default "From:" address for emails sent by the site (password resets etc.).
# Default: webmaster@localhost
# https://docs.djangoproject.com/en/6.1/ref/settings/#default-from-email
# DEFAULT_FROM_EMAIL=folio@example.com

# "From:" address for error emails sent to ADMINS.
# Default: root@localhost
# https://docs.djangoproject.com/en/6.1/ref/settings/#server-email
# SERVER_EMAIL=errors@example.com

# Addresses that receive error reports (500s) when DEBUG=False. Also used as
# MANAGERS (broken link notifications). Comma-separated.
# Default: (empty)
# https://docs.djangoproject.com/en/6.1/ref/settings/#admins
# ADMINS=ops@example.com,dev@example.com


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Minimum level logged to the console: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# Default: INFO
# https://docs.djangoproject.com/en/6.1/topics/logging/
# LOG_LEVEL=INFO
